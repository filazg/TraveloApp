<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <title>Detalji izvještaja — <%= p.partner_name %></title>
    <style>
        @page { margin: 18mm 12mm; }
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10.5px; color: #1e293b; line-height: 1.4; margin: 0; }
        .head { border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-bottom: 14px; }
        .head h1 { font-size: 18px; margin: 0 0 3px; }
        .head .meta { color: #64748b; font-size: 11px; }
        h2 { font-size: 13px; margin: 16px 0 6px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        thead th { text-align: left; font-weight: 700; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.4px; color: #475569; border-bottom: 1.5px solid #0f172a; padding: 5px 4px; }
        tbody td { padding: 4px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
        .num { text-align: right; white-space: nowrap; }
        tr.zbroj td { font-weight: 800; border-top: 1.5px solid #0f172a; border-bottom: none; padding-top: 6px; }
        .footer { margin-top: 16px; font-size: 9.5px; color: #94a3b8; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 8px; }
    </style>
</head>
<body>
<%
    var eur = function (v) { return (Number(v) || 0).toFixed(2).replace('.', ',') + ' EUR'; };
    var hrDatum = function (v) {
        var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(v || ''));
        return m ? (m[3] + '.' + m[2] + '.' + m[1] + '.') : String(v || '');
    };
    var uZagrebu = function (value) {
        var dt = value instanceof Date ? value : new Date(value);
        if (!value || isNaN(dt.getTime())) return '';
        var d = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Europe/Zagreb', year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', hour12: false,
        }).formatToParts(dt).reduce(function (acc, x) { if (x.type !== 'literal') acc[x.type] = x.value; return acc; }, {});
        return d.day + '.' + d.month + '.' + d.year + '. ' + d.hour + ':' + d.minute;
    };
%>
<div class="head">
    <h1>Detalji izvještaja za proviziju</h1>
    <div class="meta">
        <%= p.partner_name %> · razdoblje <%= hrDatum(p.from) %> – <%= hrDatum(p.to) %> ·
        provizija <%= (Number(p.commission_pct) || 0).toFixed(2) %> % · <%= zbrojPolazaka.count %> karata
    </div>
</div>

<h2>Rezime po polascima</h2>
<table>
    <thead>
        <tr>
            <th>Polazak</th><th>Linija</th><th>Relacija</th>
            <th class="num">Karte</th><th class="num">Promet</th>
            <th class="num">Osnovica</th><th class="num">Provizija</th>
        </tr>
    </thead>
    <tbody>
        <% polasci.forEach(function (r) { %>
        <tr>
            <td><%= r.departure || '—' %></td>
            <td><%= r.line %></td>
            <td><%= r.relation %></td>
            <td class="num"><%= r.count %></td>
            <td class="num"><%= eur(r.gross) %></td>
            <td class="num"><%= eur(r.base) %></td>
            <td class="num"><%= eur(r.commission) %></td>
        </tr>
        <% }); %>
        <tr class="zbroj">
            <td colspan="3">Ukupno (<%= polasci.length %> polazaka)</td>
            <td class="num"><%= zbrojPolazaka.count %></td>
            <td class="num"><%= eur(zbrojPolazaka.gross) %></td>
            <td class="num"><%= eur(zbrojPolazaka.base) %></td>
            <td class="num"><%= eur(zbrojPolazaka.commission) %></td>
        </tr>
    </tbody>
</table>

<h2>Analitika po operateru</h2>
<table>
    <thead>
        <tr>
            <th>Prodajno mjesto</th><th>Uređaj</th><th>Operater</th>
            <th class="num">Karte</th>
            <th>Prva prodaja</th><th>Zadnja prodaja</th>
            <th class="num">Promet</th><th class="num">Osnovica</th><th class="num">Provizija</th>
        </tr>
    </thead>
    <tbody>
        <% operateri.forEach(function (r) { %>
        <tr>
            <td><%= r.business_premise_name || '—' %></td>
            <td><%= r.billing_device || '—' %></td>
            <td><%= r.operator || '—' %></td>
            <td class="num"><%= r.count %></td>
            <td><%= uZagrebu(r.prva) %></td>
            <td><%= uZagrebu(r.zadnja) %></td>
            <td class="num"><%= eur(r.gross) %></td>
            <td class="num"><%= eur(r.base) %></td>
            <td class="num"><%= eur(r.commission) %></td>
        </tr>
        <% }); %>
        <tr class="zbroj">
            <td colspan="3">Ukupno</td>
            <td class="num"><%= zbrojOperatera.count %></td>
            <td colspan="2"></td>
            <td class="num"><%= eur(zbrojOperatera.gross) %></td>
            <td class="num"><%= eur(zbrojOperatera.base) %></td>
            <td class="num"><%= eur(zbrojOperatera.commission) %></td>
        </tr>
    </tbody>
</table>

<div class="footer">
    <%= p.company_name || '' %> · detalji uz izvještaj za proviziju
</div>
</body>
</html>
