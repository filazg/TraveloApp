<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <title>Partner račun <%= r.partner_invoice_no %>/<%= r.invoice_year %></title>
    <style>
        @page { margin: 20mm 15mm; }
        * { box-sizing: border-box; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #1e293b; line-height: 1.4; margin: 0; }
        .uuid-strip { text-align: center; font-family: 'Courier New', monospace; font-size: 10px; color: #94a3b8; letter-spacing: 1.5px; margin-bottom: 10px; }
        .header { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        .header td { vertical-align: top; width: 33.33%; padding: 0 8px; }
        .header td + td { border-left: 1px solid #e2e8f0; }
        .header .label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; font-weight: 700; margin-bottom: 4px; }
        .header .party { font-weight: 700; font-size: 13px; margin-bottom: 2px; }
        .title { text-align: center; margin: 8px 0 14px; padding: 10px 0; border-top: 2px solid #0f172a; border-bottom: 2px solid #0f172a; }
        .title h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: 0.5px; }
        .title .num { font-size: 15px; font-weight: 700; }
        .title .muted { color: #64748b; font-size: 11px; margin-top: 4px; }
        .title .f2-badge { display: inline-block; background: #dbeafe; color: #1d4ed8; font-weight: 700; font-size: 11px; padding: 2px 8px; border-radius: 3px; margin-top: 4px; }
        table.items { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
        table.items thead th { text-align: left; font-weight: 700; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #475569; border-bottom: 1.5px solid #0f172a; padding: 6px 4px; }
        table.items tbody td { padding: 5px 4px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
        table.items .num { text-align: right; white-space: nowrap; }
        table.items .idx { width: 26px; text-align: right; color: #64748b; }
        table.items .sub { display: block; color: #64748b; font-size: 10px; }
        .totals { width: 48%; margin-left: 52%; border-collapse: collapse; margin-bottom: 14px; }
        .totals th { text-align: left; font-weight: 600; padding: 4px 8px; color: #475569; }
        .totals td { text-align: right; padding: 4px 8px; white-space: nowrap; }
        .totals .total th, .totals .total td { font-size: 14px; font-weight: 800; color: #0f172a; border-top: 1.5px solid #0f172a; padding-top: 6px; padding-bottom: 6px; }
        .remark { font-size: 10px; color: #64748b; margin-top: 10px; line-height: 1.5; }
        .footer { margin-top: 20px; font-size: 10px; color: #94a3b8; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 10px; }
    </style>
</head>
<body>
<%
    var eur = function (v) { return (Number(v) || 0).toFixed(2).replace('.', ',') + ' EUR'; };
    // Datum i vrijeme MORAJU biti hrvatsko lokalno vrijeme: posluzitelj radi u
    // UTC-u, pa bi na racunu ljeti pisalo dva sata unatrag.
    var uZagrebu = function (value, sVremenom) {
        var dt = value instanceof Date ? value : new Date(value);
        if (!value || isNaN(dt.getTime())) return '';
        var dijelovi = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Europe/Zagreb',
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', hour12: false,
        }).formatToParts(dt).reduce(function (acc, p) { if (p.type !== 'literal') acc[p.type] = p.value; return acc; }, {});
        var datum = dijelovi.day + '.' + dijelovi.month + '.' + dijelovi.year + '.';
        return sVremenom ? datum + ' ' + dijelovi.hour + ':' + dijelovi.minute : datum;
    };
    var jeF2 = r.is_f2 != null ? !!r.is_f2 : !!r.fiskal_required;
    // Vidljiva oznaka: F1 nosi "fiskalni_broj/PP/NU", F2 svoj kod.
    var oznaka = r.partner_invoice_code
        || [r.partner_invoice_fiskal_no, r.business_premise_fiscal_mark, r.billing_device_fiscal_mark].filter(Boolean).join('/')
        || (r.partner_invoice_no + '/' + r.invoice_year);
%>
<div class="uuid-strip"><%= r.partner_invoice_uuid %></div>

<table class="header">
    <tr>
        <td>
            <div class="label">Izdavatelj / Issuer</div>
            <div class="party"><%= r.company_name || '' %></div>
            <%= r.company_address || '' %><br />
            <%= [r.company_postal_code, r.company_town].filter(Boolean).join(' ') %><br />
            <% if (r.company_legal_id) { %>OIB: <%= r.company_legal_id %><br /><% } %>
            <% if (r.company_iban) { %>IBAN: <%= r.company_iban %><% } %>
        </td>
        <td>
            <div class="label">Kupac / Buyer</div>
            <div class="party"><%= r.partner_name || '' %></div>
            <% if (r.partner_legal_id) { %>OIB: <%= r.partner_legal_id %><br /><% } %>
            <% if (r.partner_vat_id && r.partner_vat_id !== r.partner_legal_id) { %>VAT: <%= r.partner_vat_id %><br /><% } %>
            <%= r.partner_address || '' %><br />
            <%= [r.partner_postal_code, r.partner_town].filter(Boolean).join(' ') %><br />
            <%= r.partner_country || '' %>
        </td>
        <td>
            <div class="label">Podaci / Data</div>
            datum/date: <b><%= uZagrebu(r.invoice_date, true) %></b><br />
            razdoblje/period: <%= uZagrebu(r.period_from) %> – <%= uZagrebu(r.period_to) %><br />
            <%= jeF2 ? 'kod/code' : 'fisk. br./no.' %>: <b><%= oznaka %></b><br />
            plaćanje/payment: <%= r.payment_method_name || 'Virman' %><br />
            karata/tickets: <%= r.tickets_count %>
        </td>
    </tr>
</table>

<div class="title">
    <h1>Račun / Invoice</h1>
    <div class="num"><%= oznaka %></div>
    <% if (jeF2) { %><div class="f2-badge">F2</div><% } %>
    <div class="muted">Prodaja za vlastiti račun partnera</div>
</div>

<table class="items">
    <thead>
        <tr>
            <th class="idx">#</th>
            <th>Stavke / Items</th>
            <th class="num">Kol / Qty</th>
            <th class="num">Iznos / Amount</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="idx">1</td>
            <td>
                Prodane karte u razdoblju <%= uZagrebu(r.period_from) %> – <%= uZagrebu(r.period_to) %>
                <span class="sub">osnovica bez lučke pristojbe i PDV-a</span>
            </td>
            <td class="num"><%= r.tickets_count %></td>
            <td class="num"><%= eur(r.commission_base) %></td>
        </tr>
        <tr>
            <td class="idx">2</td>
            <td>
                Provizija partnera <%= (Number(r.commission_pct) || 0).toFixed(2) %> %
                <span class="sub">obračunata na osnovicu</span>
            </td>
            <td class="num"></td>
            <td class="num">− <%= eur(r.commission_amount) %></td>
        </tr>
        <tr>
            <td class="idx">3</td>
            <td>
                Lučka pristojba
                <span class="sub">prolazna stavka, oslobođeno PDV-a</span>
            </td>
            <td class="num"></td>
            <td class="num"><%= eur(r.harbor_tax_amount) %></td>
        </tr>
    </tbody>
</table>

<table class="totals">
    <tr><th>Osnovica / Tax base:</th><td><%= eur(r.vat_base) %></td></tr>
    <tr><th>PDV / VAT (<%= (Number(r.vat_rate) || 0).toFixed(0) %>%):</th><td><%= eur(r.vat_amount) %></td></tr>
    <tr><th>Lučka taksa / Port fee:</th><td><%= eur(r.harbor_tax_amount) %></td></tr>
    <tr class="total"><th>Ukupno / Total:</th><td><%= eur(r.net_amount) %></td></tr>
</table>

<div class="remark">
    Lučke takse u cijeni su prolazne stavke. Oslobođeno PDV-a prema čl. 33 st. 3 Zakona o PDV-u. /<br />
    Port taxes in the price are a passing item. Exempt from VAT according to Art. 33 paragraph 3 of the Law on VAT.
</div>

<div class="footer">
    <%= r.company_name || '' %> · <%= oznaka %> · <%= uZagrebu(r.invoice_date, true) %>
</div>
</body>
</html>
