<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <title>Karte</title>
    <style>
      /* Bez vanjskih stilova: PDF se crta u Puppeteeru, a mreza koja ceka CDN
         zna dati stranicu bez stilova ako veza zapne. Sve je ovdje. */
      @page { size: A4; margin: 0; }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        color: #383E42;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Jedna karta = jedna stranica. Zadnja nema prijelom, inace PDF zavrsi
         praznom stranicom. */
      .page {
        width: 210mm;
        height: 297mm;
        padding: 14mm 14mm 12mm;
        page-break-after: always;
        display: flex;
        flex-direction: column;
      }
      .page:last-child { page-break-after: auto; }

      .brand {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        border-bottom: 3px solid #175BD0;
        padding-bottom: 5mm;
      }
      .brand .name { font-size: 20pt; font-weight: 800; letter-spacing: .5px; }
      .brand .doc { font-size: 9.5pt; color: #6b7280; text-transform: uppercase; letter-spacing: 2px; }

      .content { flex: 1; display: flex; flex-direction: column; padding-top: 10mm; }

      /* Ukrcajni kupon. Raspored je onaj na koji je putnik navikao kod drugih
         prijevoznika: relacija i vrijeme veliko lijevo, QR na otkinutom dijelu
         desno, sitni podaci u traci ispod. */
      .pass {
        display: flex;
        border: 1px solid #cfd5db;
        border-radius: 3mm;
        overflow: hidden;
        background: #fff;
      }
      .pass .body { flex: 1; }
      .pass .strip {
        background: #175BD0;
        color: #fff;
        padding: 3.5mm 7mm;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 9.5pt;
        letter-spacing: 1px;
      }
      .pass .strip .lijevo { font-weight: 700; text-transform: uppercase; }
      .pass .strip .desno { opacity: .85; text-transform: uppercase; letter-spacing: 2px; }

      .journey {
        display: flex;
        align-items: center;
        padding: 9mm 7mm 7mm;
      }
      .place { flex: 1; }
      .place .k {
        font-size: 8pt; color: #6b7280; text-transform: uppercase;
        letter-spacing: 1.5px; margin-bottom: 1.5mm;
      }
      .place .harbor { font-size: 24pt; font-weight: 800; line-height: 1.1; }
      .place .time { font-size: 16pt; font-weight: 700; margin-top: 1.5mm; }
      .place .date { font-size: 10pt; color: #6b7280; margin-top: .8mm; }
      .place.right { text-align: right; }

      /* Put izmedu luka: tocka na polasku, crta, vrh strelice na dolasku, a
         ispod trajanje voznje. Nacrtano je CSS-om, ne znakom iz fonta —
         strelica koju font nema ispala bi kao kvadratic nasred karte. */
      .route { width: 40mm; padding: 0 4mm; text-align: center; }
      .route .rail {
        position: relative;
        height: 2.4mm;
        margin: 0 1mm;
      }
      .route .rail:before {
        content: "";
        position: absolute; left: 0; top: .55mm;
        width: 2.2mm; height: 2.2mm;
        border: .6mm solid #175BD0;
        border-radius: 50%;
        background: #fff;
      }
      /* Crta ide od tocke do vrha strelice, ne ispod njih. */
      .route .rail .line {
        position: absolute; left: 3.6mm; right: 3.2mm; top: 1.65mm;
        border-top: 1.2px dashed #8b95a0;
      }
      .route .rail:after {
        content: "";
        position: absolute; right: 0; top: .35mm;
        border-left: 3.2mm solid #175BD0;
        border-top: 1.7mm solid transparent;
        border-bottom: 1.7mm solid transparent;
      }
      .route .dur {
        margin-top: 2mm;
        font-size: 8pt;
        color: #6b7280;
        letter-spacing: .5px;
        white-space: nowrap;
      }

      .facts {
        display: flex;
        border-top: 1px dashed #cfd5db;
        padding: 5mm 7mm 6mm;
        gap: 6mm;
      }
      .facts .cell { flex: 1; }
      .facts .cell.wide { flex: 1.5; }
      .facts .k {
        font-size: 7.5pt; color: #6b7280; text-transform: uppercase;
        letter-spacing: .8px; margin-bottom: 1.2mm; white-space: nowrap;
      }
      .facts .v { font-size: 11pt; font-weight: 700; }
      .facts .v.mono { font-family: "Courier New", Courier, monospace; font-size: 10pt; letter-spacing: 0; white-space: nowrap; }

      /* Kupon za ukrcaj — odvojen probusenom crtom, kao kod svih koji karte
         kidaju na ulazu. */
      .stub {
        width: 58mm;
        border-left: 1px dashed #9aa3ad;
        background: #F7F9FC;
        padding: 6mm 5mm;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .stub .k {
        font-size: 7.5pt; color: #6b7280; text-transform: uppercase;
        letter-spacing: 1.5px; margin-bottom: 3mm;
      }
      .stub img { width: 42mm; height: 42mm; }
      .stub .code {
        margin-top: 3mm;
        font-family: "Courier New", Courier, monospace;
        font-size: 11pt; font-weight: 700; letter-spacing: .5px;
        word-break: break-all;
      }
      .stub .suffix { color: #6b7280; }

      .island {
        margin-top: 4mm; padding: 4mm 5mm;
        background: #F5F2EB; border-left: 4px solid #96D1F2;
        font-size: 10pt;
      }
      .island b { font-size: 11pt; }

      .terms {
        margin-top: 6mm;
        display: flex;
        gap: 8mm;
        font-size: 8.5pt;
        color: #6b7280;
        line-height: 1.55;
      }
      .terms .col { flex: 1; }
      .terms .col b { display: block; color: #383E42; font-size: 8pt; text-transform: uppercase; letter-spacing: 1.2px; margin-bottom: 1.5mm; }

      /* Podaci prijevoznika u podnozju — na tudim kartama stoje na istom
         mjestu, a putniku trebaju kad karta zapne pa zove nekoga. */
      .carrier {
        margin-top: 6mm;
        border-top: 1px solid #e5e7eb;
        padding-top: 4mm;
        display: flex;
        gap: 8mm;
        font-size: 8.5pt;
        color: #6b7280;
      }
      .carrier .k {
        font-size: 7.5pt; text-transform: uppercase; letter-spacing: 1.2px;
        color: #9aa3ad; margin-bottom: 1.2mm;
      }
      .carrier .v { color: #383E42; }

      .spacer { flex: 1; }

      .notes {
        border-top: 1px solid #d1d5db;
        padding-top: 3.5mm;
        font-size: 8pt;
        color: #6b7280;
      }
      .counter { float: right; font-weight: 700; color: #383E42; }

      /* --- sazetak --- */
      .sum-title { margin-top: 10mm; font-size: 20pt; font-weight: 800; }
      .sum-sub { margin-top: 1mm; font-size: 11pt; color: #6b7280; }
      table.sum { width: 100%; border-collapse: collapse; margin-top: 8mm; font-size: 10.5pt; }
      table.sum th {
        text-align: left; font-size: 8.5pt; text-transform: uppercase;
        letter-spacing: 1px; color: #6b7280; border-bottom: 2px solid #383E42;
        padding: 0 0 2mm;
      }
      table.sum td { padding: 3mm 0; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
      table.sum td.code { font-family: "Courier New", Courier, monospace; font-weight: 700; }
      table.sum .muted { color: #6b7280; font-size: 9pt; }
    </style>
  </head>
  <body>

    <%
      // Datum i vrijeme stoje jedno pod drugim, kao na kartama drugih
      // prijevoznika. Zapis dolazi spojen ("12.07.2026. 08:00") pa se ovdje
      // rastavlja; ako oblik nije takav, sve ide u datum umjesto da se izgubi.
      const dan = (v) => String(v || "").split(" ")[0] || "";
      const sat = (v) => String(v || "").split(" ")[1] || "";

      // Trajanje voznje stoji uz strelicu, kao na kartama drugih prijevoznika.
      // Racuna se iz vremena na karti; ako dolazak nije upisan, izostaje umjesto
      // da se izmislja.
      const trajanje = (od, dolazak) => {
        const uMinute = (v) => {
          const m = /^(\d{1,2}):(\d{2})$/.exec(String(v || ""));
          return m ? Number(m[1]) * 60 + Number(m[2]) : null;
        };
        const a = uMinute(od);
        const b = uMinute(dolazak);
        if (a === null || b === null) return "";
        let d = b - a;
        if (d < 0) d += 24 * 60; // polazak i dolazak preko ponoci
        if (!d) return "";
        const h = Math.floor(d / 60);
        const m = d % 60;
        if (!h) return m + " min";
        return m ? h + " h " + String(m).padStart(2, "0") + " min" : h + " h";
      };
    %>

    <% if (summary) { %>
      <%# Sazetak je prva stranica, ne zaseban dokument: karte se svugdje
          otvaraju kao jedan PDF — u kartici preglednika i kao privitak. %>
      <div class="page">
        <div class="brand">
          <div class="name"><%= companyName %></div>
          <div class="doc">Sažetak</div>
        </div>

        <div class="sum-title"><%= ticketsData.length %> karata</div>
        <div class="sum-sub">
          <% if (summary.route) { %><%= summary.route %><% } %>
          <% if (summary.departure) { %> &middot; <%= summary.departure %><% } %>
        </div>

        <table class="sum">
          <thead>
            <tr>
              <th style="width:22%">Broj karte</th>
              <th style="width:28%">Vrsta</th>
              <th style="width:32%">Relacija</th>
              <th style="width:18%">Polazak</th>
            </tr>
          </thead>
          <tbody>
            <% ticketsData.forEach(function (ti) { %>
              <tr>
                <td class="code"><%= ti.ticket_code %></td>
                <td>
                  <%= ti.ticket_type_name || "" %>
                  <% if (ti.is_island && ti.seop_card_no) { %>
                    <div class="muted"><%= ti.seop_card_no %></div>
                  <% } %>
                </td>
                <td><%= ti.departure_harbor_name || "" %> → <%= ti.arrival_harbor_name || "" %></td>
                <td><%= ti.departure_fmt || ti.departure || "" %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="spacer"></div>
        <div class="notes">
          Sažetak služi za pregled i predaju na ukrcaju. Za ukrcaj vrijedi pojedinačna
          karta s QR kodom, na stranicama koje slijede.
        </div>
      </div>
    <% } %>

    <% ticketsData.forEach(function (ti, i) { %>
      <div class="page">
        <div class="brand">
          <div class="name"><%= companyName %></div>
          <div class="doc">Prijevozna karta &middot; Ticket</div>
        </div>

        <div class="content">
          <div class="pass">
            <div class="body">
              <div class="strip">
                <div class="lijevo"><%= ti.line_name || ti.line_code || "" %></div>
                <div class="desno">Ukrcajni kupon</div>
              </div>

              <div class="journey">
                <div class="place">
                  <div class="k">Polazak / From</div>
                  <div class="harbor"><%= ti.departure_harbor_name || "" %></div>
                  <div class="time"><%= sat(ti.departure_fmt) || "—" %></div>
                  <div class="date"><%= dan(ti.departure_fmt) %></div>
                </div>

                <div class="route">
                  <div class="rail"><div class="line"></div></div>
                  <% var vozi = trajanje(sat(ti.departure_fmt), sat(ti.arrival_fmt)); %>
                  <% if (vozi) { %><div class="dur"><%= vozi %></div><% } %>
                </div>

                <div class="place right">
                  <div class="k">Dolazak / To</div>
                  <div class="harbor"><%= ti.arrival_harbor_name || "" %></div>
                  <div class="time"><%= sat(ti.arrival_fmt) || "—" %></div>
                  <div class="date"><%= dan(ti.arrival_fmt) %></div>
                </div>
              </div>

              <div class="facts">
                <div class="cell">
                  <div class="k">Vrsta karte / Fare</div>
                  <div class="v"><%= ti.ticket_type_name || "" %></div>
                </div>
                <div class="cell">
                  <div class="k">Linija / Line</div>
                  <div class="v"><%= ti.line_code || "" %></div>
                </div>
                <div class="cell wide">
                  <div class="k">Broj karte / Ticket no.</div>
                  <%# ticket_code vec nosi oznaku originala/kopije (brojZaIspis),
                      pa se ovdje ne dopisuje drugi put. %>
                  <div class="v mono"><%= ti.ticket_code %></div>
                </div>
              </div>
            </div>

            <div class="stub">
              <div class="k">Ukrcaj / Boarding</div>
              <img src="<%= ti.qr_data_url %>" alt="QR" />
              <div class="code"><%= ti.ticket_code %></div>
            </div>
          </div>

          <% if (ti.is_island && ti.seop_card_no) { %>
            <div class="island">
              Otočna karta &middot; <b><%= ti.seop_card_no %></b>
              <% if (ti.seop_pravo) { %><br /><%= ti.seop_pravo %><% } %>
              <% if (ti.seop_otok) { %> &middot; <%= ti.seop_otok %><% } %>
            </div>
          <% } %>

          <% var tvrtka = (typeof company !== "undefined" && company) ? company : {}; %>
          <% if (tvrtka.name) { %>
            <div class="carrier">
              <div style="flex:1">
                <div class="k">Prijevoznik / Carrier</div>
                <div class="v"><%= tvrtka.name %></div>
              </div>
              <% if (tvrtka.address || tvrtka.town) { %>
                <div style="flex:1">
                  <div class="k">Adresa / Address</div>
                  <div class="v">
                    <%= tvrtka.address || "" %><% if (tvrtka.town) { %>, <%= tvrtka.postal_code || "" %> <%= tvrtka.town %><% } %>
                  </div>
                </div>
              <% } %>
              <% if (tvrtka.legal_id) { %>
                <div style="flex:1">
                  <div class="k">OIB</div>
                  <div class="v"><%= tvrtka.legal_id %></div>
                </div>
              <% } %>
            </div>
          <% } %>

          <div class="terms">
            <div class="col">
              <b>Uvjeti prijevoza</b>
              Kartu s QR kodom obavezno predočite pri ukrcaju. Karta vrijedi samo za
              navedeni polazak i relaciju. Preporučuje se dolazak na vez najkasnije
              30 minuta prije polaska. Dozvoljena osobna prtljaga do 23 kg.
            </div>
            <div class="col">
              <b>Conditions of carriage</b>
              You are obligated to present the code printed on the ticket while boarding.
              The ticket is valid for the stated departure and route only. Please arrive at
              the berth at least 30 minutes before departure. Maximum luggage weight 23 kg.
            </div>
          </div>
        </div>

        <div class="notes">
          <span class="counter">Karta <%= i + 1 %>/<%= ticketsData.length %></span>
          Elektronička karta / Electronic ticket
        </div>
      </div>
    <% }); %>

  </body>
</html>
