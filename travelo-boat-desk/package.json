{
  "name": "travelo-boat-desk",
  "version": "1.0.32",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:5182 && electron .",
    "build:renderer": "cd renderer && npm run build",
    "rebuild:sqlite3": "npm rebuild sqlite3",
    "package": "npm run build:renderer && npm run rebuild:sqlite3 && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "wait-on": "^7.0.1"
  },
  "build": {
    "productName": "Travelo Boat Desk",
    "npmRebuild": false,
    "asar": true,
    "beforePack": "./installer/signing/preflight.cjs",
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico",
      "publisherName": [
        "Tech4beeZ d.o.o."
      ]
    },
    "nsis": {
      "include": "installer/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://bookingtest.krilo.hr/desk-updates/",
        "channel": "latest"
      }
    ],
    "extraResources": [
      {
        "from": "resources/tessera-cli",
        "to": "tessera-cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "installer/signing/dist-cert",
        "to": "cert",
        "filter": [
          "*.cer"
        ]
      },
      {
        "from": "installer/signing/install-cert-on-machine.ps1",
        "to": "cert/install-cert-on-machine.ps1"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "node-thermal-printer": "^4.5.0",
    "sequelize": "^6.37.7",
    "serialport": "^12.0.0",
    "sqlite3": "^5.1.7"
  }
}
