              <Text style={{fontSize:30, fontWeight:'bold'}}>POLAZNA LUKA NIJE NA PUTOVANJU</Text>
            </View>
          </>
          )
      }
      else if(selectedData.checked_tickets_data.ticket.departure_harbor_id != selectedData.selected_departure_harbor.departure_harbor_id){
