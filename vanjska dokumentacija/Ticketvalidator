import {ScrollView, StyleSheet, TouchableOpacity, View} from 'react-native';
import {Button, Text} from 'react-native-paper';
import {useDispatch, useSelector} from 'react-redux';
import {
  appSelectedData,
  appSettingsData,
  appValidationData,
  postTerminalThunk,
  setStatesData,
  setVailidateData,
} from '../controllers/mobileTerminalSlice';
import {useEffect, useState} from 'react';

import SoundPlayer from 'react-native-sound-player'

const TicketValidatorView = () => {
  const dispatch = useDispatch();
  const validateData = useSelector(appValidationData);
  const settingsData = useSelector(appSettingsData);
  const selectedData = useSelector(appSelectedData)
  const ticketsData = validateData.ticketData.related_tickets;
  const ticketData = validateData.ticketData.ticket;
  const validationStatus = validateData.validationStatus;
  
  const handleBack = async () => {
    dispatch(setStatesData({path: 'viewToShow', value: 'SCANER'}));
    dispatch(
      setVailidateData({
        path: 'validationStatus',
        value: {validate_status: 'NONE'},
      }),
    );
  };


  const handleValidateSingle = async () => {
    console.log('VALIODIRAMO SINGLE')
    let ticketsData = []
    const data = selectedData.checked_tickets_data.ticket
    ticketsData = [...ticketsData, data]
    //const parsedData = data.split(';');
    const dataToSend = {
      //ticket_uuid: parsedData[0],
      tickets_data:ticketsData,
      action:'VALIDATE'
    };
    await dispatch(
      postTerminalThunk({
        path: 'terminal/terminal/validator_validate_ticket',
        value: dataToSend,
      }))
    handleBack()
  };


  const handleValidateAll = async()=>{
    const ticketsData = selectedData.checked_tickets_data.related_tickets
    const dataToSend = {
      tickets_data:ticketsData,
      action:'VALIDATE'
    }
    await dispatch(
      postTerminalThunk({
        path: 'terminal/terminal/validator_validate_ticket',
        value: dataToSend,
      }))
    handleBack()
  }
 

  const checkTicketVithServer = async(data)=>{
    const parsedData = data.split(';');
    const dataToSend = {
      ticket_uuid: parsedData[0],
    };
    await dispatch(
      postTerminalThunk({
        path: 'terminal/terminal/validator_check_ticket',
        value: dataToSend,
      }))
    await dispatch(setSelectedData({path:'scaned_data',value:data}))
    //await dispatch(setStatesData({path: 'viewToShow', value: 'TICKET VALIDATE'}));
  }

  useEffect(()=>{
      checkTicketVithServer(selectedData.scaned_data)
  },[selectedData.scaned_data])

  


  
  const CheckTicket = ()=>{
    let ticketScanedData = {} 
    const scan = selectedData.scaned_data;
    const parsedData = scan.split(';');
    console.log(selectedData.checked_tickets_data.ticket)
    console.log(selectedData.tickets_data)
    console.log(selectedData.selected_sailing)
    console.log(selectedData.selected_departure_harbor)
    if(selectedData.checked_tickets_data.ticket.ticket_uuid === parsedData[0]){
      const selectSailingHarborItem = selectedData.tickets_data.find((dep)=>dep.departure_harbor_id === selectedData.checked_tickets_data.ticket.departure_harbor_id)

      //linija
      if(selectedData.checked_tickets_data.ticket.line_code != selectedData.selected_sailing.line_code){
        return (
          <>
            <View style={{height:'85%', backgroundColor:'red', borderWidth:2, justifyContent:'center',alignItems:'center'}}>
              <Text style={{fontSize:30, fontWeight:'bold'}}>NEODGOVARAJUCA LINIJ</Text>
            </View>
          </>
          )
      }
      else if(!selectSailingHarborItem){
        //luka se nalazi na ruti
        return (
          <>
