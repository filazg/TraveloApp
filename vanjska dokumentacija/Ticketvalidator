      else if(selectedData.checked_tickets_data.ticket.status != 'ISSUED'){
        return (
          <>
            <View style={{height:'85%'}}>
            <TouchableOpacity style={{height:'100%', width:'100%', backgroundColor:'red', borderWidth:5,justifyContent:'center',alignItems:'center'}}
                onPress={handleBack}
              >
                <Text style={{fontSize:30, fontWeight:'bold'}}>KARTA NIJE VALJANA</Text>

              </TouchableOpacity>
              
             
            </View>
