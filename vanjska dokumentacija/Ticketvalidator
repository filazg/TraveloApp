              >
              <Text style={{fontSize:30, fontWeight:'bold'}}>{selectedData.checked_tickets_data.ticket.ticket_type_name}</Text>
              <Text style={{fontSize:30, fontWeight:'bold'}}>KARTA JE VALJANA</Text>
              <Text style={{fontSize:30, fontWeight:'bold'}}>PRITISNI ZA VALIDACIJU</Text>

              </TouchableOpacity>
            </View>
          </>
          )
      }
      else{
        return (
          <>
            <View style={{height:'85%', backgroundColor:'green', borderWidth:2, justifyContent:'center',alignItems:'center'}}>
              <TouchableOpacity style={{height:'100%', width:'100%', borderWidth:5}}
                onPress={handleBack}
              >

              </TouchableOpacity>
              <Text style={{fontSize:30, fontWeight:'bold'}}>nemam pojma kaj se dogada</Text>
            </View>
          </>
          )
      }

    
    }else{
      //const routeForTicket = selectedData.tickets_data.find((route)=> route.departure_harbor_id === selectedData.selected_sailing.)
      console.log('ili smo tu smo')
    
    }
  }


  return (
    <>
      <View style={{height: '100%', justifyContent: 'flex-start', borderWidth:2}}>
        <TouchableOpacity
          style={{...styles.button, height: 60, backgroundColor:'red'}}
          onPress={handleBack}
        >
          <Text style={styles.text}>POVRATAK</Text>
        </TouchableOpacity>

