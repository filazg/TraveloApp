                <Text style={{fontSize:20, fontWeight:'bold'}}>KARTE</Text>
              </TouchableOpacity>
              <TouchableOpacity 
                style={{height:'80%',width:'45%', backgroundColor:'green',justifyContent:'center',alignItems:'center'}}
