          <>
            <View style={{height:'85%', backgroundColor:'red', borderWidth:2, justifyContent:'center',alignItems:'center'}}>
              <Text style={{fontSize:30, fontWeight:'bold'}}>UKURCAJ NA KRIVOJ LUCI</Text>
            </View>
          </>
          )
      }
      else if(selectSailingHarborItem.departure != selectedData.checked_tickets_data.ticket.departure){
        //vrijeme polaska
        return (
          <>
            <View style={{height:'85%', backgroundColor:'red', borderWidth:2, justifyContent:'center',alignItems:'center'}}>
              <Text style={{fontSize:30, fontWeight:'bold'}}>VRIJEME POLASKA NE ODGOVARA</Text>
            </View>
          </>
          )
