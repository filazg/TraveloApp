                >
                <Text style={{fontSize:20, fontWeight:'bold'}}>VALIDIRAJ</Text>
                <Text style={{fontSize:20, fontWeight:'bold'}}>SAMO KARTU</Text>
                <Text style={{fontSize:25, fontWeight:'bold', marginTop:20}}>{selectedData.checked_tickets_data.ticket.ticket_code}</Text>
              </TouchableOpacity>
              
            </View>
            </View>
          </>
          )
      }
      else if(selectedData.checked_tickets_data.related_tickets.length < 1){
        //handleValidateSingle()
        SoundPlayer.playAsset(require('../assets/soundok.mp3'))
        return (
          <>
            <View style={{height:'85%'}}>
            <TouchableOpacity style={{height:'100%', width:'100%', backgroundColor:'green', borderWidth:5,justifyContent:'center',alignItems:'center'}}
