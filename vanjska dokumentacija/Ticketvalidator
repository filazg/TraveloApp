                    <Text style={{marginLeft:3, fontSize:20, }}>kod karte:</Text>
                    <Text style={{fontSize:20, fontWeight:'bold', textAlign:'center'}}>{ticket.ticket_code}</Text>

                 </TouchableOpacity>
              ))}
              </ScrollView>
            </View>
            <View style={{flexDirection: 'row', height:'35%', width:'100%', justifyContent:'space-around',alignItems:'center'}}>
              
              <TouchableOpacity 
